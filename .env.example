# "dev" or "prod" — selects which local Mongo database is used
# (hoi4_planner_dev / hoi4_planner_prod). Collections are always "focuses" and "plans".
APP_ENV=dev
MONGO_URI=mongodb://localhost:27017

# Sub-path the app is served under, when a reverse proxy serves it there and
# strips the prefix (e.g. URL_PREFIX=/hoi4). Production only — leave it empty in
# dev and in tests, where the app lives at the root.
URL_PREFIX=

# Signs the session cookie — set a long random value in production
# (python -c "import secrets; print(secrets.token_hex(32))").
FLASK_SECRET_KEY=
